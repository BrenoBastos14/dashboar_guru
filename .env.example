# =============================================================================
# DeepSeek (LLM)
# =============================================================================
# Obtenha sua chave em https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Modelo disponível na API DeepSeek. O nome "V4 Flash" mencionado não existe
# oficialmente — use deepseek-chat (V3) ou deepseek-reasoner.
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# =============================================================================
# Evolution API
# =============================================================================
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-please
# URL que a Evolution API usa para te enviar webhooks.
# - Em Docker Desktop (Mac/Win): http://host.docker.internal:8000/webhook
# - Em Linux com extra_hosts:   http://host.docker.internal:8000/webhook
# - Em produção: a URL pública do seu backend (ex: https://api.seudominio.com/webhook)
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:8000/webhook

# =============================================================================
# Backend
# =============================================================================
DB_PATH=data/whatsapp_bot.db
HISTORY_LIMIT=20
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=800
DEFAULT_SYSTEM_PROMPT="Você é um atendente virtual atencioso e útil. Responda de forma breve, clara e em português."

# =============================================================================
# Streamlit (página WhatsApp Bot)
# =============================================================================
WHATSAPP_BACKEND_URL=http://localhost:8000
WHATSAPP_DEFAULT_WEBHOOK=http://host.docker.internal:8000/webhook
