# ===========================================
# CREDENCIAIS DO GOOGLE CLOUD CONSOLE
# ===========================================
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret

# ===========================================
# CONFIGURAÇÃO DA APLICAÇÃO
# ===========================================
# URL base onde a aplicação está rodando
# Desenvolvimento: http://localhost:3000
# Produção: https://seudominio.com
BASE_URL=http://localhost:3000

# Porta em que o servidor vai escutar
PORT=3000

# ===========================================
# REMETENTE A SER ADICIONADO À WHITELIST
# ===========================================
# Email que vai ser marcado como importante no Gmail dos usuários
SENDER_EMAIL=contato@seudominio.com

# ===========================================
# URLS DE REDIRECIONAMENTO
# ===========================================
# Para onde mandar o usuário após sucesso ou erro
SUCCESS_REDIRECT_URL=http://localhost:3000/sucesso.html
ERROR_REDIRECT_URL=http://localhost:3000/erro.html
