{
  "$schema": "https://railway.app/railway-schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd analisador-criativos && npm install && npm run build"
  },
  "deploy": {
    "startCommand": "cd analisador-criativos && npm start -- -p ${PORT:-3000}",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
